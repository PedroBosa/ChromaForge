    "name": "Pedro Bosa",
    "url": "https://github.com/PedroBosa"
  },
  "license": "MIT",
  "homepage": "https://pedrobosa.github.io/ChromaForge/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PedroBosa/ChromaForge.git"
  },
  "bugs": {
    "url": "https://github.com/PedroBosa/ChromaForge/issues"
  },
  "keywords": [
    "oklch",
    "colorimetry",
    "design-tokens",
    "tailwind-v4",
    "apca",
    "wcag",
    "color-spaces",
    "gamut-mapping",
    "bezier-easing",
    "p3-gamut",
    "w3c-tokens",
    "react",
    "typescript",
    "vite",
    "tailwind"
  ],
  "private": true,
