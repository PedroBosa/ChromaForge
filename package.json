  },
  "keywords": [
    "oklch",
    "colorimetry",
    "design-tokens",
    "tailwind-v4",
    "apca",
    "wcag",
    "color-spaces",
    "gamut-mapping",
    "bezier-easing",
    "p3-gamut",
    "w3c-tokens"
  ],
  "type": "module",
  "scripts": {
